# ============================================================
# Lokneeti-3B — Environment Configuration
# Copy this file to .env and populate secrets
# NEVER commit the real .env to version control
# ============================================================

# --- HuggingFace ---
HF_TOKEN=hf_your_token_here
HF_ORG=vikhram-labs
HF_MODEL_REPO=vikhram-labs/Lokneeti-3B
HF_DATASET_REPO=vikhram-labs/lokneeti-governance-dataset

# --- Weights & Biases (optional) ---
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=lokneeti-3b
WANDB_ENTITY=vikhram-labs

# --- Paths ---
DATA_DIR=./data
OUTPUT_DIR=./outputs
CHECKPOINT_DIR=./checkpoints

# --- Base Model ---
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# --- Training ---
MAX_SEQ_LENGTH=2048
BATCH_SIZE=2
GRAD_ACCUM=8
LEARNING_RATE=2e-4
NUM_EPOCHS=3
LORA_RANK=16
LORA_ALPHA=32
